# Formatting for the C++ tree.
#
# Google style with a 4-space indent, matching the surrounding implementations'
# density rather than importing a house style nobody here reads.
#
# ColumnLimit is 100, not background-file-mover's 80. That is a deliberate
# divergence from the sibling repository: this tree carries long fully-qualified
# requirement identifiers and long CSV column literals inline, and at 80 columns
# clang-format breaks them across lines in ways that make a grep for
# "L2-WRT-012" or "TIME_STAMP,RT,MSG" stop matching. Searchability of the
# requirement tags beats column parity with another repo.
#
# Checked in CI with `make format-check`; apply with `clang-format -i <files>`.
# Vendored headers under third_party/ are never formatted -- they are excluded
# by the file lists in the Makefile, which are built from sources.txt.

Language:        Cpp
BasedOnStyle:    Google

IndentWidth:     4
ColumnLimit:     100
AccessModifierOffset: -2

# Pinned rather than derived, so a file that happens to lean the other way
# cannot flip the whole tree's pointer style on the next reformat.
DerivePointerAlignment: false
PointerAlignment: Left
SortIncludes:    true
IncludeBlocks:   Preserve

# All, not Google's Inline. Inline permits a one-line body only for a function
# defined INSIDE a class, so namespace-scope one-liners like
#
#     uint64_t process_id() { return static_cast<uint64_t>(::getpid()); }
#
# get expanded to three lines. The platform layer is full of these -- thin
# wrappers whose entire content is one call -- and three lines each buries the
# handful of functions that actually do something. Widened deliberately.
AllowShortFunctionsOnASingleLine: All

# Never, not Google's WithoutElse. A one-line `if` is where a second statement
# gets appended later and silently falls outside the branch. Braces always.
AllowShortIfStatementsOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: true

BreakBeforeBraces: Attach
SpaceAfterCStyleCast: false
Cpp11BracedListStyle: true

# The floor the SLES 12 system compiler sets (ADR-0001). Telling clang-format
# the standard matters for more than cosmetics: at c++11 it will not reformat
# code into constructs the target compiler cannot parse.
Standard:        c++11
